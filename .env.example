# Copy to .env and edit. Vite only exposes variables that start with VITE_.

# Final live domain, no trailing slash. Used for canonical URLs, Open Graph, schema,
# sitemap.xml and robots.txt (sitemap/robots are regenerated on every `npm run build`).
VITE_SITE_URL=https://www.rjhandyman.example

# Optional: URL that accepts a JSON POST from the contact form (Formspree, a Netlify
# Function, your own API...). While empty, the form clearly tells visitors it is not
# connected yet and offers WhatsApp instead of pretending to submit.
VITE_FORM_ENDPOINT=
